# Copie para .env local ou preencha Render > serviço > Environment.
NODE_ENV=development
PORT=8080
SITE_URL=http://127.0.0.1:8080
# Segredos: somente no servidor. 32 bytes em hex ou base64 canônico do Render.
SESSION_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Configurado por setup:cloud após SMTP e templates; não libera sem remetente.
AUTH_EMAIL_READY=false
# Acompanhamento restrito ao protótipo; exige também concessão privada com validade e MFA.
PROTOTYPE_ADMIN_ENABLED=false
# Identificação organizacional pública, exigida antes de abrir contratações.
SERVICE_OWNER=
PRIVACY_CONTACT=
# Avisos comerciais opcionais por HTTPS. E-mail de Auth é configurado no Supabase.
RESEND_API_KEY=
EMAIL_FROM=
LEADS_EMAIL=
# Ajuda pública; permanece local até aprovação dos termos e liberação administrativa.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_HELP_APPROVED=false
AI_DAILY_CALL_LIMIT=100
AI_MAX_CONCURRENCY=2
# Análise técnica separada. Esta implementação aceita somente projetos públicos autorizados.
REQUIREMENTS_AI_PROVIDER=none
REQUIREMENTS_GEMINI_API_KEY=
REQUIREMENTS_GEMINI_MODEL=
REQUIREMENTS_AI_APPROVED=false
# Migrações/backup: terminal operacional, NUNCA configurar estas credenciais no serviço web.
MIGRATION_DATABASE_URL=
# TLS permanece obrigatório fora do PostgreSQL efêmero local.
MIGRATION_SSL=require
# Acessos operacionais locais; nunca copie estes quatro campos para o Render.
SUPABASE_ACCESS_TOKEN=
RENDER_API_KEY=
# Senha de app do Gmail informado em PRIVACY_CONTACT, sem a senha normal da conta.
AUTH_SMTP_PASSWORD=
# SHA completo já testado e enviado ao GitHub, somente ao publicar por API.
DEPLOY_COMMIT=
BACKUP_DATABASE_URL=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=
# Restauração somente em banco vazio e Storage isolado; veja DEPLOY_RENDER.md.
RESTORE_DATABASE_URL=
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_SECRET_KEY=
RESTORE_TARGET_ACK=
RESTORE_DELETIONS_FILE=
