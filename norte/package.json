{
  "name": "norte",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "start": "node servidor.cjs",
    "dev": "node --env-file-if-exists=.env servidor.cjs",
    "build": "node scripts/build.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:db": "node scripts/test-db.cjs",
    "test:browser": "playwright test",
    "test:real": "node --env-file-if-exists=.env.test --test tests/real/*.test.cjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.cjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.cjs",
    "scan:secrets": "node scripts/secrets.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "docx": "9.10.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "supertest": "7.3.1"
  }
}
